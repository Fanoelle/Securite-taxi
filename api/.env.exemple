# Copier en .env et adapter.  NE JAMAIS COMMITER .env
NODE_ENV=development
PORT=3000

# Base de donnees
# Laisser vide pour la socket Unix locale (pas de mot de passe requis).
# Renseigner l'hote bascule en TCP : PGPASSWORD devient alors obligatoire.
PGHOST=
PGPORT=5432
PGDATABASE=securitaxi
PGUSER=fanounou
PGPASSWORD=

# Jetons d'authentification
JWT_SECRET=changer-cette-valeur-en-production
JWT_EXPIRATION=7d

# URL publique servant de base aux QR et aux liens de suivi
URL_PUBLIQUE=http://localhost:3000

# Stockage des documents justificatifs (hors depot git)
STOCKAGE_DOCUMENTS=./stockage/documents

# SMS - laisser vide en developpement : les messages sont ecrits en console
SMS_FOURNISSEUR=console
SMS_NEXAH_CLE=
SMS_NEXAH_UTILISATEUR=
# Identifiant d'expediteur - a declarer aupres de l'ART avant production
SMS_EXPEDITEUR=SECURITAXI

# Photos de profil des chauffeurs - servies publiquement, contrairement
# aux pieces justificatives.
STOCKAGE_PHOTOS=./stockage/photos
