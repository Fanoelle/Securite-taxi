# =====================================================================
#  Configuration du deploiement — MODELE
#
#  Copier ce fichier en .env, puis remplir. Le .env n'est jamais
#  committe : il contient les secrets de production.
#
#      cp .env.example .env
#
#  Les deux secrets ci-dessous se generent, ils ne s'inventent pas.
#  Un mot de passe choisi de tete est devine ; 32 octets tires au sort
#  ne le sont pas :
#
#      openssl rand -base64 32
#
#  Lancer la commande deux fois, coller un resultat dans chaque champ.
# =====================================================================

# --- Le domaine ------------------------------------------------------
# Sans le https://, sans barre oblique finale.  Exemple : securitaxi.org
# Ce domaine doit deja pointer vers l'IP du serveur (enregistrement DNS
# de type A) avant le premier demarrage, sinon Let's Encrypt refusera
# le certificat.
DOMAINE=

# Adresse prevenue par Let's Encrypt si un certificat n'arrive pas a se
# renouveler. Une boite reellement relevee.
COURRIEL_TLS=

# --- La base de donnees ----------------------------------------------
POSTGRES_DB=securitaxi
POSTGRES_USER=securitaxi
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Signature des jetons de session ---------------------------------
# openssl rand -base64 32
# Changer cette valeur deconnecte tout le monde : c'est le geste a
# faire si l'on soupconne une fuite.
JWT_SECRET=
JWT_EXPIRATION=12h

# --- Envoi des SMS ---------------------------------------------------
# `console` : les SMS sont ecrits dans les journaux au lieu d'etre
# envoyes. C'est le bon reglage pour une demonstration — les codes de
# connexion se lisent alors avec `docker compose logs api`.
#
# `nexah` : envoi reel. Exige les identifiants ci-dessous ET un
# identifiant d'expediteur declare aupres de l'ART. Ne pas basculer
# avant d'avoir cette declaration.
SMS_FOURNISSEUR=console
SMS_NEXAH_UTILISATEUR=
SMS_NEXAH_MOTDEPASSE=
SMS_NEXAH_URL=
SMS_EXPEDITEUR=

# --- Entretien : sauvegardes et purges -------------------------------
# Un service tourne toutes les nuits. Il sauvegarde la base et les
# pieces d'identite, puis efface les traces GPS de plus de 30 jours —
# ce que la loi n° 2024/017 impose.
#
# Ou sont ecrites les sauvegardes, sur le serveur. Le dossier est cree
# au premier demarrage s'il n'existe pas.
CHEMIN_SAUVEGARDES=./sauvegardes

# Quand, au format HH:MM. 3 h du matin : le trafic est au plus bas, et
# une sauvegarde ralentit la base le temps qu'elle dure.
HEURE_ENTRETIEN=03:00
FUSEAU_HORAIRE=Africa/Douala

# Combien de jours de sauvegardes garder. Au-dela, les plus anciennes
# sont supprimees — sinon le disque se remplit et la plateforme
# s'arrete.
RETENTION_SAUVEGARDES_JOURS=14

# Duree de conservation des traces GPS, en jours. 30 est la valeur
# retenue au titre de la loi n° 2024/017 : ne l'augmentez pas sans
# raison juridique.
RETENTION_GPS_JOURS=30

# Passer a true pour lancer un entretien des le demarrage, afin de
# verifier que tout fonctionne sans attendre la nuit. A remettre a
# false ensuite.
ENTRETIEN_AU_DEMARRAGE=false

# --- Documentation interactive ---------------------------------------
# Swagger decrit toute la surface de l'API, y compris les points
# d'entree reserves aux agents. Ferme par defaut en production.
# Le passer a true est un choix a assumer, utile pour une demonstration
# technique devant l'autorite.
SWAGGER_PUBLIC=false
