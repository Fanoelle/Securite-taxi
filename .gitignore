# Dépendances et sorties de compilation
node_modules/
dist/
build/

# Secrets — ne jamais committer
.env
.env.local
.env.*.local

# Pièces d'identité et photos des chauffeurs.
# Ces fichiers sont des données personnelles : ils n'ont rien à faire
# dans un dépôt, même privé.
stockage/
api/stockage/

# Journaux et fichiers temporaires
*.log
npm-debug.log*
.DS_Store
*.swp
*~

# Les captures de test-visuel/captures/ sont versionnées à dessein :
# elles montrent à quoi ressemble le produit sans avoir à le lancer.

# Profil du navigateur de test : 146 Mo de cache, régénéré à chaque run.
test-visuel/.chr/
